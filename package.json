{
  "name": "hells-bells",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run catalog && vite dev --host 127.0.0.1 --port 5197 --strictPort",
    "build": "bun run catalog && vite build && bun scripts/finalize-build.ts",
    "check": "bun run catalog && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "prepare": "svelte-kit sync",
    "catalog": "bun scripts/catalog.ts",
    "art:prepare": "bun scripts/prepare-art.ts",
    "review": "bun scripts/review.ts",
    "test:play": "bun scripts/play-browser.ts && bun scripts/multiplayer-browser.ts",
    "test:engine": "bun test tests/engine",
    "test:backend": "firebase emulators:exec --project demo-hellsbells --only auth,firestore \"bun test tests/backend\"",
    "test:animations": "bun scripts/animation-browser.ts",
    "rl:train": "bun scripts/rl/train-q.ts",
    "rl:evaluate": "bun scripts/rl/evaluate.ts models/rl-bid.json models/rl-discard.json",
    "rl:baseline": "bun scripts/rl/evaluate.ts",
    "rl:train:bids": "bun scripts/rl/train-q.ts",
    "rl:train:discards": "bun scripts/rl/train-discard.ts",
    "rl:verify": "MIN_WIN_RATE=0.60 bun scripts/rl/evaluate.ts models/rl-bid.json models/rl-discard.json",
    "test:rl-play": "bun scripts/rl/browser.ts",
    "rl:train:league": "bun scripts/rl/train-league.ts",
    "rl:train:tactics": "bun scripts/rl/train-tactics.ts",
    "rl:verify:v2": "bun scripts/rl/verify-league.ts",
    "rl:train:planner": "bun scripts/rl/train-planner.ts",
    "test:setup": "bun scripts/setup-browser.ts",
    "rl:train:multi": "bun scripts/rl/train-multi.ts",
    "rl:train:multi-tactics": "bun scripts/rl/train-multi-tactics.ts",
    "rl:evaluate:multi": "bun scripts/rl/evaluate-multi.ts",
    "rl:verify:v3": "bun scripts/rl/verify-multi.ts",
    "rl:report:v3": "bun scripts/rl/report-multi.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.2.8",
    "@fontsource/cormorant-garamond": "5.2.11",
    "firebase": "^13.4.0",
    "marked": "^16.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/bun": "^1.3.0",
    "sharp": "^0.35.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "GPL-3.0-only",
  "packageManager": "bun@1.3.13"
}
